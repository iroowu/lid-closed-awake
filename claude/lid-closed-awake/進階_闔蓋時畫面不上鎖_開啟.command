#!/bin/bash
# 闔蓋不睡｜進階：闔蓋時畫面不上鎖（不需要密碼）
cd "$(dirname "$0")" || exit 1
clear
cat <<'TXT'
進階：闔蓋時畫面不上鎖

什麼時候需要：要讓 Claude 在你闔蓋時「操作畫面」，例如點 App、用瀏覽器、螢幕錄影。
只用手機遙控聊天、跑排程、下載檔案，不需要開這個。

為什麼：闔蓋不睡之後，闔蓋約 3 分鐘螢幕睡著時，Mac 會上鎖，要操作畫面的工作就會卡住。
開了以後，蓋子闔著時畫面保持醒著，就不會上鎖；打開蓋子立刻恢復平常的規則。

代價：闔蓋期間畫面沒有鎖，別人這時打開蓋子，不用密碼就能進桌面。
帶出門前請點「進階_闔蓋時畫面不上鎖_關閉.command」。
TXT
echo
read -r -p "按 Return 開啟；不要的話直接關掉這個視窗。" _
/bin/bash "./scripts/display_install.sh"
echo
read -r -p "按 Return 關閉。" _
